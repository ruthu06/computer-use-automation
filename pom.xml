<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.computeruse</groupId>
    <artifactId>computer-use-automation</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>computer-use-automation</name>
    <description>LLM discovery compiled into deterministic, replayable UI capabilities</description>

    <properties>
        <java.version>21</java.version>
        <playwright.version>1.63.0</playwright.version>
        <anthropic.version>2.34.0</anthropic.version>
        <!-- Smoke tests need the ParaBank container, so a plain `./mvnw test` skips them. -->
        <test.groups/>
        <test.excludedGroups>smoke</test.excludedGroups>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${playwright.version}</version>
        </dependency>
        <dependency>
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java</artifactId>
            <version>${anthropic.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <groups>${test.groups}</groups>
                    <excludedGroups>${test.excludedGroups}</excludedGroups>
                    <environmentVariables>
                        <!-- Browsers are installed once, explicitly (Chromium only); never as a test side effect. -->
                        <PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD>1</PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD>
                    </environmentVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!-- ./mvnw test -Psmoke : only the tests that drive the live ParaBank container. -->
            <id>smoke</id>
            <properties>
                <test.groups>smoke</test.groups>
                <test.excludedGroups/>
            </properties>
        </profile>
    </profiles>
</project>
